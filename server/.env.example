PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ats_resume_analyzer
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
CLIENT_URL=http://localhost:5173
# For multiple frontend origins, separate URLs with commas (no spaces required).
# Example: CLIENT_URL=http://localhost:5173,https://preview.example.com,https://app.example.com
